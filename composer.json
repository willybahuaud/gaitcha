{
    "name": "willybahuaud/gaitcha",
    "description": "Invisible, self-hosted CAPTCHA combining behavioral analysis, random field names, and HMAC tokens.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gaitcha\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaitcha\\Tests\\": "tests/php/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --colors=always --testsuite=unit",
        "test:integration": "phpunit --colors=always --testsuite=integration"
    },
    "config": {
        "sort-packages": true
    }
}
